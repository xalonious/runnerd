GITHUB_APP_ID='123456'
GITHUB_PRIVATE_KEY_PATH='/etc/ssl/runnerd/github-app.pem'
GITHUB_WEBHOOK_SECRET='replace-with-a-random-webhook-secret'
LISTEN_ADDR='127.0.0.1:3333'
RUNNER_HOME='/opt/runnerd/runner'
RUNNER_STATE_DIR='/var/lib/runnerd/runners'
RUNNER_LABEL='runnerd'
RUNNER_GROUP_ID='1'
MAX_CONCURRENT_RUNNERS='1'
QUEUE_SIZE='100'
LOG_LEVEL='info'
SHUTDOWN_TIMEOUT='30s'
RUNNER_TIMEOUT='1h'
